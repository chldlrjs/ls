<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LEESLE - Lookbook</title>
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Noto+Serif+KR:wght@300;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #F5F2EB;
            --text-color: #111;
            --font-main: 'Nanum Myeongjo', serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Noto Serif KR', serif;
            overflow-x: hidden;
        }

        /* 네비게이션 (메인과 동일) */
        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 20px 50px; position: fixed; width: 100%; top: 0; z-index: 100;
            background: rgba(245, 242, 235, 0.9); /* 스크롤 시 배경 살짝 비치게 */
        }
        .logo { font-family: var(--font-main); font-weight: 800; font-size: 2rem; letter-spacing: 5px; color: #111; text-decoration: none; }
        .menu a { text-decoration: none; color: #333; margin-left: 30px; font-size: 0.9rem; opacity: 0.6; transition: 0.3s; }
        .menu a:hover { opacity: 1; }

        /* 룩북 헤더 */
        .lookbook-header {
            padding: 150px 50px 50px;
            text-align: center;
        }
        .lookbook-header h1 {
            font-family: var(--font-main); font-size: 3rem; margin-bottom: 20px;
        }
        .lookbook-header p {
            color: #555; letter-spacing: 1px;
        }

        /* 갤러리 그리드 레이아웃 */
        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); /* 화면 크기에 따라 자동 정렬 */
            gap: 20px;
            padding: 0 50px 100px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .gallery-item {
            position: relative;
            background: #e8e6df;
            height: 500px; /* 사진 높이 고정 */
            overflow: hidden;
            border: 1px solid #ddd;
            transition: 0.3s;
        }
        
        /* 마우스 올렸을 때 살짝 떠오르는 효과 */
        .gallery-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .gallery-item img {
            width: 100%; height: 100%; object-fit: cover;
            transition: 0.5s;
        }

        /* 마우스 올리면 이미지 확대 */
        .gallery-item:hover img {
            transform: scale(1.05);
        }

        .item-info {
            position: absolute; bottom: 0; left: 0; width: 100%;
            padding: 20px;
            background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
            color: #fff;
            opacity: 0; transition: 0.3s;
        }

        .gallery-item:hover .item-info { opacity: 1; }

        /* 뒤로가기 버튼 영역 */
        .back-area {
            text-align: center; padding-bottom: 80px;
        }
        .btn-back {
            display: inline-block; padding: 15px 40px; border: 1px solid #111;
            color: #111; text-decoration: none; transition: 0.3s;
        }
        .btn-back:hover { background: #111; color: #fff; }

        footer { text-align: center; padding: 50px; color: #aaa; font-size: 0.8rem; border-top: 1px solid #ddd; }
    </style>
</head>
<body>

    <nav>
        <a href="lshp.html" class="logo">LEESLE</a>
        <div class="menu">
            <a href="#">COLLECTION</a>
            <a href="#">SHOP</a>
            <a href="#">LOGIN</a>
        </div>
    </nav>

    <header class="lookbook-header">
        <h1>LOOKBOOK</h1>
        <p>2026 S/S COLLECTION '墨'</p>
    </header>

    <section class="gallery">
        <div class="gallery-item">
            <img src="lb1.jpg" alt="Look 01">
            <div class="item-info">Look 01. Black Durumagi</div>
        </div>

        <div class="gallery-item">
            <img src="lb2.jpg" alt="Look 02">
            <div class="item-info">Look 02. Jeogori Vest</div>
        </div>

        <div class="gallery-item">
            <img src="gt.png" alt="Look 03">
            <div class="item-info">Look 03. Wide Pants</div>
        </div>
        
        <div class="gallery-item">
            <img src="lb3.jpg" alt="Look 04">
            <div class="item-info">Look 04. Hanbok Skirt</div>
        </div>
    </section>

    <div class="back-area">
        <a href="lshp.html" class="btn-back">메인으로 돌아가기</a>
    </div>

    <footer>
        &copy; 2026 LEESLE. Designed by Choiminsung.
    </footer>

</body>
</html>
